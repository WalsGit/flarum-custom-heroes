{
    "name": "walsgit/flarum-custom-heroes",
    "description": "Customize the hero headers of your Flarum forum: background image, overlay, height, logo, text, social icons and buttons.",
    "keywords": [
        "flarum",
        "extension",
        "hero",
        "header",
        "banner",
        "customization"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/tags": "Customize the hero of each tag page (background, overlay, height)."
    },
    "authors": [
        {
            "name": "Wa!id",
            "homepage": "https://discuss.flarum.org/u/Walid",
            "role": "Developer"
        }
    ],
    "funding": [
        {
            "type": "website",
            "url": "https://walsgit.github.io/Donations/"
        }
    ],
    "support": {
        "issues": "https://github.com/WalsGit/flarum-custom-heroes/issues",
        "source": "https://github.com/WalsGit/flarum-custom-heroes"
    },
    "autoload": {
        "psr-4": {
            "Walsgit\\CustomHeroes\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Custom Heroes",
            "category": "feature",
            "icon": {
                "name": "fas fa-panorama",
                "color": "#fff",
                "backgroundColor": "#008e97"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": true,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": true,
                "frontendTesting": true,
                "backendTesting": true,
                "phpstan": true,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Walsgit\\CustomHeroes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "require-dev": {
        "flarum/testing": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "fof/pages": "^2.0",
        "tryhackx/flarum-advanced-pages": "^2.0"
    }
}
